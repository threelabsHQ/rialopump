# ════════════════════════════════════════════════════════════════════════════════
# hugefun — environment variables reference
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
# ════════════════════════════════════════════════════════════════════════════════

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Fine-grained PAT for gh CLI and git push.
# Create at: https://github.com/settings/personal-access-tokens
# Required repository permissions:
#   Administration: Read & Write  (create repos)
#   Contents:       Read & Write  (git push/pull)
#   Pull requests:  Read & Write  (open PRs)
#   Metadata:       Read          (auto-selected)
GITHUB_PAT=github_pat_REPLACE_ME

# ─── Cloudflare ──────────────────────────────────────────────────────────────
# Account ID — https://dash.cloudflare.com → right sidebar of any zone (or Workers overview)
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME

# API Token — https://dash.cloudflare.com/profile/api-tokens → Create Token → Custom Token
# Required permission: Account > Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=REPLACE_ME

# Pages project name — must match the project you create in the Cloudflare dashboard.
# If you haven't created it yet, the GitHub Actions workflow will create it automatically
# on first deploy via: wrangler pages project create rialopump
CLOUDFLARE_PAGES_PROJECT=rialopump

# ─── Rialo / App ─────────────────────────────────────────────────────────────
# Rialo devnet RPC endpoint (default is already in server/index.ts)
# RIALO_DEVNET_RPC=https://devnet.rialo.io:4101

# Vite public vars — baked into the frontend bundle at build time.
# Override these if you run the backend somewhere other than localhost:3001.
# VITE_PROGRAM_ID=2PDinBj36DXxwXd9VR8vKes1c5MfP8QLEaVXDDAnNQ1s
# VITE_API_BASE=https://your-backend.example.com

# ─── AI (optional) ───────────────────────────────────────────────────────────
# Enables full Fable 5 AI market analysis (gracefully falls back to heuristics without it)
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
